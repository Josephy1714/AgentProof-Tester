{
  "name": "live-provider-smoke-test",
  "version": "1.0.0",
  "schema_version": "1.0",
  "tests": [
    {
      "id": "returns-json-status",
      "category": "formatting",
      "timeout_seconds": 30,
      "input": "Return only a valid JSON object with exactly these fields: {\"status\":\"ok\",\"answer\":\"hello\"}. Do not use markdown.",
      "assertions": [
        {"type": "equals", "path": "status", "expected": "ok"},
        {"type": "equals", "path": "answer", "expected": "hello"},
        {"type": "has_key", "expected": "status"}
      ]
    }
  ]
}
